// Starter only. Run npm run setup -- --provider cloudflare to produce
// ignored wrangler.generated.jsonc for your own account. npm run deploy refuses
// to deploy this unconfigured template.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unspammed-unconfigured",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "migrations": [{ "tag": "v1-admin", "new_sqlite_classes": ["TelegramAdmin"] }],
  "durable_objects": {
    "bindings": [{ "name": "TELEGRAM_ADMIN", "class_name": "TelegramAdmin" }],
  },
  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
  "observability": { "enabled": true },
  "vars": { "DEV_MODE": "false", "DATABASE_BACKEND": "postgres" },
}
