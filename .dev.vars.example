# Local demo defaults only. npm run dev creates a separate .tmp/dev/local.vars.
# Use WATCHTOWER_ENV_FILE explicitly to supply credentials for your own test group.
# Production setup uses .env.example and npm run setup.
DEV_MODE=true
DATABASE_BACKEND=sqlite
TELEGRAM_CHAT_ID=-1001234567890
OWNER_TELEGRAM_ID=123456789
ADMIN_EMAIL=owner@example.com
TELEGRAM_BOT_USERNAME=
PUBLIC_URL=
DASHBOARD_URL=
MINI_APP_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Optional test-only Telegram admin credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_KEY=
