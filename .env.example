# Copy to ignored .env. Process environment wins over file values.
# UNSPAMMED_ENV_FILE selects an explicit file; legacy WATCHTOWER_* options remain supported.
# .dev.vars is a legacy fallback. Canonical UNSPAMMED_* options win over their aliases.
# Run npm run setup -- --provider cloudflare|railway|digitalocean|vercel|render|fly.
UNSPAMMED_PROVIDER=
UNSPAMMED_NAME=
DEV_MODE=false
DATABASE_BACKEND=postgres

# Public HTTPS origin, with no path. Set after reserving your provider hostname.
PUBLIC_URL=
# Optional separate dashboard origin and owner menu URL.
DASHBOARD_URL=
MINI_APP_URL=

# Create your bot with @BotFather. Run npm run telegram:discover for IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional immutable database namespace. Keep this value when changing default group.
DATABASE_ROOT_CHAT_ID=
OWNER_TELEGRAM_ID=
# Optional: inferred and verified by Telegram bootstrap from getMe.
TELEGRAM_BOT_USERNAME=
# Generated by setup when empty. Never put this in public config.
TELEGRAM_WEBHOOK_SECRET=

# PostgreSQL on any host. Keep admin/bootstrap credentials out of runtime hosting.
DATABASE_URL=
DATABASE_ADMIN_URL=
# verify-full validates the server certificate. Use disable only for an explicit private network.
DATABASE_SSL_MODE=verify-full
# Optional PEM CA on Node hosts. Direct Workers require public certificate trust;
# configure a custom CA on Hyperdrive itself instead. Quoted multiline values work.
DATABASE_SSL_CA=
# Legacy WORKER_URL and PLANETSCALE_DATABASE_URL/PLANETSCALE_ADMIN_DATABASE_URL still work.

# Optional browser sign-in. setup --browser-auth generates a 32-byte token.
# Keep this server-side. Changing it revokes existing browser sessions.
BROWSER_AUTH_TOKEN=
# Optional alternative: configure all three Cloudflare Access values together.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
ADMIN_EMAIL=

# Persistent Node hosts use the built-in minute scheduler by default.
# UNSPAMMED_SCHEDULER=false
# Generated by setup; authenticates the Vercel minute cron endpoint.
CRON_SECRET=
OPENROUTER_API_KEY=
# POLICY_DRAFT_MODEL=google/gemini-2.5-flash
# CUSTOM_API_KEY=
# MODEL_PROVIDERS_JSON=[{"id":"custom","name":"Custom","baseUrl":"https://provider.example/v1","apiKeyEnv":"CUSTOM_API_KEY","format":"json_object"}]

# Cloudflare only: use your account and unique Worker name, no original-owner defaults.
CLOUDFLARE_ACCOUNT_ID=
# Optional hostname in a zone you own; leave empty to use workers.dev.
CLOUDFLARE_CUSTOM_DOMAIN=
# Optional Hyperdrive. Direct DATABASE_URL is supported without it.
HYPERDRIVE_ID=

# Optional full-history Telegram admin service; get API values at my.telegram.org/apps.
# Preserve TELEGRAM_SESSION_KEY for the lifetime of encrypted sessions.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_KEY=
