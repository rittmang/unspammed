# Only these build inputs enter the context. Custom credential files stay out
# even when their names differ from .env or app.env.
**
!Dockerfile
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!src/*.ts
!src/*.tsx
!src/*.css
!shared/*.ts
!public/favicon.svg
!public/theme.js
!worker/*.ts
!server/*.ts
!scripts/setup-env.mjs
!scripts/database-setup.ts
!scripts/setup.mjs
!scripts/setup-lib.mjs
!scripts/telegram-client.mjs
!scripts/telegram-setup.mjs
!scripts/telegram-mini-app.mjs
