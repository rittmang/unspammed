# Copy to ignored app.env in the repository root on the VM. Set your values.
# Run sudo sh deploy/vm/install.sh. No Telegram endpoints are registered.
# To select another ignored file, set UNSPAMMED_ENV_FILE; UNSPAMMED_VM_ENV overrides it.
# Existing WATCHTOWER_* options remain supported; canonical UNSPAMMED_* values win.
PUBLIC_URL=https://your-domain-or-vm-address.example
DATABASE_URL=
# Blank selects verified TLS for an external database. For bundled-db, use disable.
DATABASE_SSL_MODE=
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_bot_username
OWNER_TELEGRAM_ID=123456789
TELEGRAM_CHAT_ID=-1001234567890

# External PostgreSQL: set DATABASE_URL above and leave COMPOSE_PROFILES empty.
# Optional bootstrap-only admin URL; never passed to the normal application.
# DATABASE_ADMIN_URL=

# Or select bundled-db to create a private PostgreSQL database. Leave DATABASE_URL
# blank on first install: setup generates separate admin/application passwords,
# a restricted application role, the connection URL and DATABASE_SSL_MODE=disable.
# Existing passwords are preserved. Changing these does not rotate a saved volume.
COMPOSE_PROFILES=
# COMPOSE_PROFILES=bundled-db,https
# POSTGRES_PASSWORD=
# UNSPAMMED_DATABASE_PASSWORD=

# For the https profile, point this domain at the VM and match PUBLIC_URL above.
# Open inbound 80 and 443. Caddy stores certificates in its named volume.
UNSPAMMED_DOMAIN=
# The app port is loopback-only by default; Caddy reaches it on the private network.
UNSPAMMED_BIND=127.0.0.1
UNSPAMMED_PORT=3000
