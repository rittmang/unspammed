# Copy to app.env in the repository root on the VM. Set real values.
# Never commit this file.
PUBLIC_URL=https://your-domain-or-vm-address.example
DATABASE_URL=postgresql://user:password@db-host:5432/database
DATABASE_SSL_MODE=verify-full
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_bot_username
OWNER_TELEGRAM_ID=123456789
TELEGRAM_CHAT_ID=-1001234567890

# Only for the bundled-db profile in docker-compose.yml:
# POSTGRES_PASSWORD=choose-a-long-password
# and set DATABASE_URL=postgresql://watchtower:that-password@db:5432/watchtower
# and DATABASE_SSL_MODE=disable (private Compose network only).
