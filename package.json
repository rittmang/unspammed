{
  "name": "watchtower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:setup && npm run test:runtime && npm run test:vercel",
    "deploy": "node scripts/deploy.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "telegram:discover": "node scripts/telegram-discover.mjs",
    "telegram:mini-app": "node scripts/telegram-mini-app.mjs",
    "telegram:admin:configure": "node scripts/telegram-admin-configure.mjs",
    "database:setup": "tsx scripts/database-setup.ts",
    "start": "node --import tsx server/index.ts",
    "setup": "node scripts/setup.mjs",
    "setup:doctor": "node scripts/setup.mjs --doctor",
    "setup:check": "node scripts/setup.mjs --check",
    "test:setup": "node --test tests/setup*.test.mjs tests/deployment.test.mjs",
    "test:runtime": "node --import tsx --test tests/portable-runtime.test.mjs",
    "test:vercel": "npm run build:vercel && node --test tests/vercel-build.test.mjs",
    "test:fresh": "node scripts/verify-fresh-install.mjs",
    "test:compose": "node scripts/verify-compose.mjs"
  },
  "dependencies": {
    "@streamparser/json": "^0.0.26",
    "big-integer": "^1.6.52",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "teleproto": "^1.230.1",
    "zod": "^4.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "4.1.11",
    "wrangler": "^4.149.0"
  }
}
